{% set selected = 'recording' %}
{% extends 'templates/base.twig' %}
{% block icon %}fa-video-camera
{% endblock %}
{% block title %}Recording
{% endblock %}
{% block head_title %}Recording
{% endblock %}


{% block other_assets %}
	<link rel="stylesheet" type='text/css' href="{{ base_url('assets/styles/submit.css') }}"/>
{% endblock %}


{% block main_content %}
	<div>
		{% if all_problems|length == 0 %}
		<p style="text-align: center;">Nothing to show...</p>
		{% endif %}

		{% for one_problem in all_problems %}
			<div{{ problem.id == one_problem.id ? ' class="hl"' }}>
				<span>{{ one_problem.id }}</span>
				<span>
					<a dir="auto" href="{{ site_url("recording/#{assignment.id}/#{one_problem.id}") }}">{{ one_problem.name }}</a>
				</span>
				<span>{{ one_problem.score }}</span>
				<span>{{ one_problem.is_upload_only ? 'Yes' : 'No' }}</span>
			</div>
		{% endfor %}
	</div>
{% endblock %}
{# main_content #}
